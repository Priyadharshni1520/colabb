      import socket 
import threading 
import time 
# Function to run the UDP server 
def run_udp_server(): 
    server_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)  # Create UDP socket 
    server_socket.bind(('0.0.0.0', 9090))  # Bind to any address on port 9090 
    print("Server: Waiting for messages...") 
    # Receive message 
    data, addr = server_socket.recvfrom(1024)  # Buffer size is 1024 bytes 
    print(f"Server: Received message '{data.decode()}' from {addr}") 
    server_socket.close() 
# Function to run the UDP client 
def run_udp_client(): 
    time.sleep(2)  # Wait for the server to start 
    client_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)  # Create UDP socket 
    message = "Hello from Client!" 
    print(f"Client: Sending message: {message}") 
    client_socket.sendto(message.encode(), ('127.0.0.1', 9090))  # Send message to server on port 9090 
    client_socket.close() 
# Run the server and client using threads 
server_thread = threading.Thread(target=run_udp_server) 
client_thread = threading.Thread(target=run_udp_client) 
server_thread.start() 
client_thread.start() 
server_thread.join() 
client_thread.join() 
 
 
 
