      Stop-and-Wait ARQ (Automatic Repeat Request) protocol: 
Python Program: 
import random, time 
def sender(frame_id): 
    print(f"Sending frame {frame_id}") 
    time.sleep(2); return random.random() > 0.1 
def receiver(frame_id): 
    time.sleep(1); print(f"Receiver received frame {frame_id}. Sending ACK."); return True 
def stop_and_wait_protocol(): 
    frame_id = 1 
    while True: 
        if sender(frame_id):  
            if receiver(frame_id):  
                print(f"Acknowledgment received for frame {frame_id}"); frame_id += 1 
        else: print(f"Retrying frame {frame_id}..."); time.sleep(1) 
stop_and_wait_protocol() 
 
