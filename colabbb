      import socket 
import threading 
import time 
# Function to run the server 
def run_server(): 
    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM) 
    server_socket.bind(('0.0.0.0', 9090))  # Use a different port 
    server_socket.listen(1) 
    print("Server: Waiting for connection...") 
    conn, addr = server_socket.accept() 
    print(f"Server: Connected to {addr}") 
    data = conn.recv(1024).decode() 
    print("Server: Received message:", data) 
    conn.close() 
    server_socket.close() 
# Function to run the client 
def run_client(): 
    time.sleep(2)  # Ensure the server starts first 
    client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM) 
    client_socket.connect(('127.0.0.1', 9090))  # Match the server port 
    message = "Hello from Client!" 
    print("Client: Sending message:", message) 
    client_socket.send(message.encode()) 
    client_socket.close() 
 
 
# Running both server and client using threads 
server_thread = threading.Thread(target=run_server) 
client_thread = threading.Thread(target=run_client) 
server_thread.start() 
client_thread.start() 
server_thread.join() 
client_thread.join()

